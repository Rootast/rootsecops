# Hostnames only: no http://, https://, port, or path.
# Generate .env and random secrets with: python3 scripts/configure.py
COMPOSE_PROJECT_NAME=rootsecops
FRONT_DOMAIN=rootsecops.test
API_DOMAIN=api.rootsecops.test

# Standard public ports; the frontend calls API_DOMAIN using the UI's protocol.
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_HOST=0.0.0.0
TLS_CERT_DAYS=365
CLIENT_MAX_BODY_SIZE=100m

# Keep these bindings private behind Nginx.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://backend:8000

# Required, generated by scripts/configure.py. Never publish your .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Extra origins only; both protocols for FRONT_DOMAIN are added automatically.
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Applied at backend startup. Change .env and recreate backend to update.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
POSTGRES_DB=rootsecops
POSTGRES_USER=rootsecops
POSTGRES_PASSWORD=

FILE_SANDBOX_MAX_UPLOAD_MB=50
TRIVY_CACHE_DIR=/app/var/trivy
TRIVY_DB_REPOSITORY=ghcr.io/aquasecurity/trivy-db:2
TOOL_CRAWLER_INTERVAL_SECONDS=21600
YARA_RULE_REPOS=https://github.com/Yara-Rules/rules,https://github.com/Neo23x0/signature-base
